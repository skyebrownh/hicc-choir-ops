# Copy to .env (git-ignored) and fill in. Placeholders only: never put real secrets here.

# Any long random string. Make one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# "true" for local development; leave unset (off) in production.
DEBUG=true

# postgres://user:password@host:port/name
DATABASE_URL=postgres://localhost:5432/hicc_choir_ops

# Comma-separated. Leave empty locally: localhost is allowed automatically when DEBUG=true.
# In production: the Railway address, e.g. your-app.up.railway.app
ALLOWED_HOSTS=
# In production: https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Sign-in emails go out through Resend. Leave RESEND_API_KEY empty locally (with DEBUG=true)
# and the sign-in code prints in the server console instead.
# In production both are required: the API key (Resend > API Keys) and a sending address
# on the verified subdomain.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=HICC Choir Ops <signin@mail.hicctools.com>

# How many reverse proxies sit in front of the app, for the sign-in rate limit (AC-7).
# 0 locally (use the connection's own address). Set 1 on Railway.
NUM_PROXIES=0
